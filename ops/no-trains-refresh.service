[Unit]
Description=Trigger no-trains calendar refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=gregg
EnvironmentFile=/etc/no-trains-refresh.env
# Up to 5 attempts, 5 minutes apart (~20 min), then report failure.
Environment=REFRESH_ATTEMPTS=5 REFRESH_RETRY_DELAY=300
ExecStart=/usr/local/bin/no-trains-refresh
# Must cover the whole retry window.
TimeoutStartSec=30min
UMask=0077
